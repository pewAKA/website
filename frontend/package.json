{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/dev-with-db.ps1",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "db:generate": "drizzle-kit generate",
    "db:baseline": "drizzle-kit pull --config drizzle.baseline.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "drizzle-kit check",
    "auth:create-admin": "auth create-admin --config ./src/server/auth/auth.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "next start"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@fumadocs/mdx-remote": "^1.5.1",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-query": "^5.101.2",
    "antd": "^6.5.0",
    "axios": "^1.18.1",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.0.2",
    "fumadocs-core": "^16.15.0",
    "fumadocs-ui": "^16.15.0",
    "gsap": "^3.15.0",
    "leva": "^0.10.1",
    "lodash": "^4.18.1",
    "mysql2": "^3.23.4",
    "next": "16.2.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/lodash": "^4.17.24",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.185.1",
    "auth": "^1.7.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.4",
    "sass": "^1.101.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "style-to-js@^1.0.0": "1.1.21"
  }
}
